
@model WebApplication3.Models.InventoryItem

@{
    ViewBag.Title = "Inventory Item Details";
}

<h2>Inventory Item Details</h2>

<dl class="dl-horizontal">
    <dt>Item ID</dt>
    <dd>@Model.ItemId</dd>

    <dt>Item Name</dt>
    <dd>@Model.ItemName</dd>

    <dt>Category</dt>
    <dd>@Model.Category</dd>

    <dt>Quantity</dt>
    <dd>@Model.Quantity</dd>

    <dt>Price</dt>
    <dd>@Model.Price.ToString("0.00")</dd>

    <dt>Supplier</dt>
    <dd>@Model.Supplier</dd>
</dl>

<p>
    @Html.ActionLink("Edit Item", "Edit",
        new { id = Model.ItemId }, new { @class = "btn btn-primary" })

    @Html.ActionLink("Back to Inventory", "Index",
        null, new { @class = "btn btn-default" })
</p>
