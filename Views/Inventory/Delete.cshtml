
@model WebApplication3.Models.InventoryItem

@{
    ViewBag.Title = "Delete Inventory Item";
}

<h2>Delete Inventory Item</h2>

<h4>Are you sure you want to delete this item?</h4>

<dl class="dl-horizontal">
    <dt>Item ID</dt>
    <dd>@Model.ItemId</dd>

    <dt>Item Name</dt>
    <dd>@Model.ItemName</dd>

    <dt>Category</dt>
    <dd>@Model.Category</dd>

    <dt>Quantity</dt>
    <dd>@Model.Quantity</dd>

    <dt>Price</dt>
    <dd>@Model.Price.ToString("0.00")</dd>

    <dt>Supplier</dt>
    <dd>@Model.Supplier</dd>
</dl>

@using (Html.BeginForm("Delete", "Inventory",
    new { id = Model.ItemId }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">Confirm Delete</button>

    @Html.ActionLink("Cancel", "Index",
        null, new { @class = "btn btn-default" })
}
